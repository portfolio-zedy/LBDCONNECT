// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// LBD Nation Connect — accounts. Leaders sign in with phone + password.
// Members no longer self-sign-in; they are registered by leaders (upcoming module).
model User {
  id           String   @id @default(cuid())
  fullName     String
  phone        String   @unique
  passwordHash String
  role         String // "leader" (sign-in) | "member" (registered by leaders)
  leaderLevel  String? // leaders only: "international" | "colony" | "hub" | "tribe"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Join Daily Prayers — meeting links.
// GET /api/prayers/link returns the Zoom link only to signed-in leaders;
// everyone else (guests on the landing page) is pointed to the WhatsApp orientation platform.
model PrayerLink {
  id           String   @id @default(cuid())
  label        String   @default("Bethel Daily Prayers")
  zoomLink     String   @default("https://app.zoom.us/wc/85079858028/join?ref_from=launch&pwd=dThLSmN3MXRLUUU4VDB0UkJJWENFQT09&_x_zm_rtaid=icnGPZ2jS2-L9j5jwK5_Eg.1784841843999.040b545f9a3cdacfc35604f20663936d&_x_zm_rhtaid=473&fromPWA=1")
  whatsappLink String   @default("https://chat.whatsapp.com/LBD-Nation-Orientation")
  updatedAt    DateTime @updatedAt
}